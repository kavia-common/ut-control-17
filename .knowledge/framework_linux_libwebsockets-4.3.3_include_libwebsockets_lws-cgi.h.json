{"is_source_file": true, "format": "C header file", "description": "This file defines types, enums, constants, and function declarations related to CGI (Common Gateway Interface) handling in the libwebsockets library. It includes API elements for spawning, managing, and interacting with CGI processes, specifically in a networked context. The file provides interface declarations but no implementations.", "external_files": ["lws_protocol_vhost_options"], "external_methods": ["lws_get_socket_fd()"], "published": ["lws_cgi", "lws_cgi_write_split_stdout_headers", "lws_cgi_kill", "lws_cgi_get_stdwsi", "lws_cgi_args", "lws_enum_stdinouterr", "lws_cgi_hdr_state"], "classes": [], "methods": [{"name": "lws_cgi", "description": "Spawn a network-connected CGI process with specified execution parameters and environment.", "parameters": ["wsi: connection object owning the process", "exec_array: array of command and arguments for execution, null-terminated", "script_uri_path_len: length of the URI path to the script or -1", "timeout_secs: maximum allowed execution time", "mp_cgienv: environment options for CGI"]}, {"name": "lws_cgi_write_split_stdout_headers", "description": "Write CGI output accounting for header part separation among stdout and headers.", "parameters": ["wsi: connection object associated with CGI process"]}, {"name": "lws_cgi_kill", "description": "Terminate the CGI process associated with the given connection.", "parameters": ["wsi: connection object"]}, {"name": "lws_cgi_get_stdwsi", "description": "Retrieve the wsi (WebSocket/connection object) for stdin, stdout, or stderr of a CGI process.", "parameters": ["wsi: parent connection object", "ch: which stream to access (stdin, stdout, stderr)"]}], "calls": ["lws_get_socket_fd()"], "search-terms": ["libwebsockets cgi", "spawn network-connected cgi", "lws_cgi", "lws_cgi_args", "lws_cgi_kill", "lws_cgi_get_stdwsi", "lws_cgi_write_split_stdout_headers", "cgi header state", "lws_protocol_vhost_options"], "state": 2,