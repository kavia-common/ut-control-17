{"is_source_file": true, "format": "C header file", "description": "This file defines enumerations, function prototypes, and macros related to tracking progress information within the cURL library. It includes declarations for progress timers, setting progress sizes, updating progress, and timing functions used to monitor transfer states.", "external_files": ["timeval.h"], "external_methods": [], "published": ["Curl_pgrsDone", "Curl_pgrsStartNow", "Curl_pgrsSetDownloadSize", "Curl_pgrsSetUploadSize", "Curl_pgrsSetDownloadCounter", "Curl_pgrsSetUploadCounter", "Curl_ratelimit", "Curl_pgrsUpdate", "Curl_pgrsResetTransferSizes", "Curl_pgrsTime", "Curl_pgrsLimitWaitTime", "Curl_pgrsTimeWas"], "classes": [], "methods": [{"name": "Curl_pgrsDone", "description": "Marks the progress as completed for the given Curl_easy session."}, {"name": "Curl_pgrsStartNow", "description": "Initializes or starts the progress timer for the session."}, {"name": "Curl_pgrsSetDownloadSize", "description": "Sets the total download size for the session."}, {"name": "Curl_pgrsSetUploadSize", "description": "Sets the total upload size for the session."}, {"name": "Curl_pgrsSetDownloadCounter", "description": "Updates the current downloaded byte count; returns a CURLcode status."}, {"name": "Curl_pgrsSetUploadCounter", "description": "Updates the current uploaded byte count."}, {"name": "Curl_ratelimit", "description": "Applies rate limiting based on progress data and current time."}, {"name": "Curl_pgrsUpdate", "description": "Updates the internal progress information, returns an int status."}, {"name": "Curl_pgrsResetTransferSizes", "description": "Resets transfer size information for a session."}, {"name": "Curl_pgrsTime", "description": "Retrieves timing information for a specific progress timer."}, {"name": "Curl_pgrsLimitWaitTime", "description": "Calculates wait time based on progress limits and current state."}, {"name": "Curl_pgrsTimeWas", "description": "Updates timing information with a