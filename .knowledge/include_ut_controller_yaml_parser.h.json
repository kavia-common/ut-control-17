{"is_source_file": true, "format": "C header file", "description": "This file declares the interface for a YAML parser utility tailored for controller configurations, specifically handling HPF (HAL Profile Format) YAML payloads used in AV buffer configuration. It provides functions for creating/destroying parser instances, loading YAML data from files or memory, validating schemas, and accessing YAML fields, including specialized helpers for AV buffer configs.", "external_files": ["<ut_kvp.h>"], "external_methods": ["ut_kvp_open()", "ut_kvp_openMemory()"], "published": ["ut_ctrl_yaml_status_t", "ut_ctrl_yaml_parser_t", "ut_ctrl_avbuffer_config_t"], "classes": [], "methods": [{"name": "ut_ctrl_yaml_parser_create", "description": "Creates a new YAML parser instance."}, {"name": "ut_ctrl_yaml_parser_destroy", "description": "Destroys a parser instance, freeing resources."}, {"name": "ut_ctrl_yaml_parser_load_file", "description": "Loads YAML data from a specified file into the parser."}, {"name": "ut_ctrl_yaml_parser_load_memory", "description": "Loads YAML data from an in-memory string into the parser."}, {"name": "ut_ctrl_yaml_parser_validate_avbuffer_schema", "description": "Validates the presence and basic correctness of AV buffer keys in the YAML."}, {"name": "ut_ctrl_yaml_get_u32", "description": "Retrieves a uint32 scalar value from YAML via a key path."}, {"name": "ut_ctrl_yaml_get_string", "description": "Retrieves a string scalar value from YAML via a key path."}, {"name": "ut_ctrl_yaml_field_present", "description": "Checks if a specific key is present in the YAML document."}, {"name": "ut_ctrl_yaml_get_avbuffer_config", "description": "Attempts to populate an AV buffer config structure by checking multiple key candidates."}], "calls": ["ut_kvp_open()", "ut_kvp_openMemory()"], "search-terms": ["YAML parser", "controller YAML", "AV buffer configuration", "HPF YAML", "ut_ctrl_yaml_parser_create", "ut_ctrl_yaml_parser_load_file", "ut_ctrl_yaml_get_u32"], "state