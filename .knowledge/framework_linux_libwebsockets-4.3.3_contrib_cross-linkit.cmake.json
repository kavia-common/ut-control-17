{"is_source_file": true, "format": "cmake", "description": "This is a CMake configuration script used for cross-compiling a project targeting the Mediatek Linkit 7967 platform. It sets toolchain paths, compiler flags, and feature configuration options required to build the project for a specific embedded environment.", "external_files": [], "external_methods": [], "published": [], "classes": [], "methods": [], "calls": ["set", "set(CROSS_BASE /opt/linkit/sdk)", "set(CROSS_PATH ${CROSS_BASE}/tools/gcc/gcc-arm-none-eabi)", "set(CMAKE_SYSTEM_NAME Generic)", "set(CMAKE_C_COMPILER \"${CROSS_PATH}/bin/arm-none-eabi-gcc\")", "set(CMAKE_CXX_COMPILER \"${CROSS_PATH}/bin/arm-none-eabi-g++\")", "set(CMAKE_C_COMPILER_WORKS 1)", "set(CMAKE_CXX_COMPILER_WORKS 1)", "set(LWS_HAVE_mbedtls_ssl_conf_alpn_protocols 1)", "set(LWS_HAVE_mbedtls_ssl_get_alpn_protocol 1)", "set(LWS_HAVE_mbedtls_ssl_conf_sni 1)", "set(LWS_HAVE_mbedtls_ssl_set_hs_ca_chain 1)", "set(LWS_HAVE_mbedtls_ssl_set_hs_own_cert 1)", "set(LWS_HAVE_mbedtls_ssl_set_hs_authmode 1)", "set(LWS_HAVE_mbedtls_net_init 1)", "set(LWS_HAVE_mbedtls_md_setup 1)", "set(LWS_HAVE_mbedtls_rsa_complete 1)", "set(LWS_HAVE_mbedtls_internal_aes_encrypt 1)", "set(CMAKE_C_FLAGS \"... -lnosys -nostartfiles ...\")", "set(CMAKE_FIND_ROOT_PATH \"${CROSS_PATH}\")", "set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)", "set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)", "set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)"], "search-terms": ["cross-compilation", "Mediatek Linkit 7967", "CMake toolchain", "embedded build", "mbedtls", "gcc-arm-none-eabi"], "state": 2, "file_id": 2872, "knowledge_revision": 6152, "git_revision": "89f806042aeb7d846617a94434a5413879bb7109", "hash": "75235d2b8e41994628d46eb5bf4c79cc", "format-version": 4, "code-base-name": "ut-control-17", "filename": "framework/linux/libwebsockets-4.3.3/contrib/cross-linkit.cmake", "revision_history": [{"6152": "89f806042aeb7d846617a94434a5413879bb7109"}]}