{"is_source_file": true, "format": "C", "description": "This source file implements various protocols and handlers related to exporting and proxying OpenMetrics metrics via libwebsockets. It includes implementations for direct HTTP export, WebSocket proxying (both server and client sides), and Proxy server functionalities to facilitate metrics collection from connected clients and aggregation. It also manages connection retries, message formatting, and client management specific to this OpenMetrics plugin.", "external_files": ["<libwebsockets.h>", "<string.h>", "<stdlib.h>", "<sys/stat.h>", "<fcntl.h>", "<unistd.h>", "<assert.h>"], "external_methods": ["lws_open", "lws_strncpy", "lws_parse_uri", "lws_sa_create", "lwsac_free", "lwsac_use", "lwsac_sizeof", "lwsac_get_next", "lwsac_get_tail_pos", "lws_add_http_common_headers", "lws_finalize_write_http_header", "lws_http_basic_auth_gen", "lws_start_foreach_dll", "lws_container_of", "lws_protocol_vh_priv_zalloc", "lws_protocol_vh_priv_get", "lws_http_transaction_completed", "lws_wsi_close", "lws_callback_on_writable", "lws_write", "lws_callback_http_dummy", "lws_validity_confirmed", "lws_retry_sul_schedule", "lws_snprintf", "lws_ptr_diff_size_t", "lwsac_get_tail_pos", "lws_strnncpy", "lws_host_get_name", "lws_get_vhost", "lws_get_protocol", "lws_vh_tag", "lws_start_foreach_dll", "lws_container_of", "lws_vhd_find_by_pvo"], "published": ["lws_openmetrics_export_protocols", "lws_openmetrics_export"], "classes": [{"name": "struct vhd", "description": "Represents a Virtual Host Data structure used for managing proxy and connection states within the OpenMetrics WebSocket proxy protocols."}, {"name": "struct pss", "description": "Represents a per-connection state, including message buffer, associated WSI, and client flags for proxy and export management."}], "methods": [{"name": "void openmetrics_san(char * nm,size_t nl)", "description": "Sanitizes metric names to conform to openmetrics token charset by replacing invalid characters with underscores.", "scope": "", "scopeKind": ""}, {"name": "int lws_metrics_om_format_agg(lws_metric_pub_t * pub,const char * nm,lws_usec_t now,int gng,char * buf,size_t len)", "description": "Formats aggregated metrics data into openmetrics format, supporting different report types and including tags like 'go' and 'nogo'.", "scope": "", "scopeKind": ""}, {"name": "int lws_metrics_om_ac_stash(struct pss * pss,const char * buf,size_t len)", "description": "Stores formatted metric data into the lwsac buffer for transmission.", "scope": "", "scopeKind": ""}, {"name": "int lws_metrics_om_format(struct pss * pss,lws_metric_pub_t * pub,const char * nm)", "description": "Converts internal metrics to openmetrics format and stores in a lwsac, handling histograms, counters, and means.", "scope": "", "scopeKind": ""}, {"name": "int append_om_metric(lws_metric_pub_t * pub,void * user)", "description": "Callback for iterating over metrics, sanitizing names, and formatting them into openmetrics data.", "scope": "", "scopeKind": ""}, {"name": "int ome_prepare(struct lws_context * ctx,struct pss * pss)", "description": "Prepares snapshot of metrics and system info into a buffer, assembling a complete OpenMetrics text report, including target metadata, version info, load averages, and individual metrics.", "scope": "", "scopeKind": ""}, {"name": "int callback_lws_openmetrics_export(struct lws * wsi,enum lws_callback_reasons reason,void * user,void * in,size_t len)", "description": "HTTP handler that responds with the current metrics in openmetrics format for direct scraper access.", "scope": "", "scopeKind": ""}, {"name": "struct:pss * omc_lws_om_get_other_side_pss_client(struct vhd * vhd,struct pss * pss)", "description": "Finds the corresponding peer connection's pss structure by proxy path for proxy interactions.", "scope": "", "scopeKind": ""}, {"name": "int callback_lws_openmetrics_prox_agg(struct lws * wsi,enum lws_callback_reasons reason,void * user,void * in,size_t len