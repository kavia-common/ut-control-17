{"is_source_file": true, "format": "C", "description": "This file implements caching of file contents in memory using a custom Memory Allocation Cache (LAC), with periodic freshness checks based on file modification time. It provides functions for managing cached file data, including reference counting, detachment, and reloading when the file changes.", "external_files": ["private-lib-core.h", "private-lib-misc-lwsac.h"], "external_methods": [], "published": [], "classes": [], "methods": [{"name": "void lwsac_use_cached_file_start(lwsac_cached_file_t cache)", "description": "Increment the reference count for a cached file to ensure it is not freed while in use.", "scope": "", "scopeKind": ""}, {"name": "void lwsac_use_cached_file_end(lwsac_cached_file_t * cache)", "description": "Decrement the reference count for a cached file. Free the cache if no longer referenced and marked detached.", "scope": "", "scopeKind": ""}, {"name": "void lwsac_use_cached_file_detach(lwsac_cached_file_t * cache)", "description": "Mark the cached file as detached, meaning it can be freed when reference count reaches zero.", "scope": "", "scopeKind": ""}, {"name": "int lwsac_cached_file(const char * filepath,lwsac_cached_file_t * cache,size_t * len)", "description": "Retrieve or reload the cached file into memory, checking for freshness every 5 seconds based on file modification time.", "scope": "", "scopeKind": ""}], "calls": ["open", "fstat", "close", "read", "lwsac_use", "lwsac_free"], "search-terms": ["lwsac_cached_file", "cached_file_info", "memory cache", "file freshness", "reference counting"], "state": 2, "file_id": 3257, "knowledge_revision": 6524, "git_revision": "89f806042aeb7d846617a94434a5413879bb7109", "ctags": [{"_type": "tag", "name": "cache_file_to_lac", "path": "/home/kavia/workspace/code-generation/ut-control-17/framework/linux/libwebsockets-4.3.3/lib/misc/lwsac/cached-file.c", "pattern": "/^#define cache_file_to_lac(/", "file": true, "language": "C", "kind": "macro", "s